{
  "id": "aks-production-resilience",
  "title": "Restore AKS production resilience within a cost ceiling",
  "level": "architect",
  "family": "optimize",
  "cloud": "azure",
  "checks": [
    {"check_id":"AKS-001","domain":"reliability","points":20,"path":"main.tf","contains":"min_count\\s*=\\s*[23]","description":"Maintain at least two nodes during normal operation."},
    {"check_id":"AKS-002","domain":"performance","points":15,"path":"main.tf","contains":"max_count\\s*=\\s*[4-9]","description":"Define scale-out capacity."},
    {"check_id":"AKS-003","domain":"reliability","points":15,"path":"main.tf","contains":"zones\\s*=\\s*\\[","description":"Distribute nodes across zones."},
    {"check_id":"AKS-004","domain":"operations","points":15,"path":"main.tf","contains":"enable_auto_scaling\\s*=\\s*true","description":"Enable cluster autoscaling."},
    {"check_id":"SEC-001","domain":"security","points":20,"path":"main.tf","forbids":"api_server_authorized_ip_ranges\\s*=\\s*\\[\\s*\"0\\.0\\.0\\.0/0","hard_gate":true,"description":"Do not expose the control plane to every source."},
    {"check_id":"FIN-001","domain":"finops","points":15,"path":"economics.json","contains":"\"monthly_cost_delta_usd\"\\s*:\\s*(?:[0-9]{1,3}|1[0-3][0-9]{2}|1400)","description":"Remain within the synthetic $1,400 monthly ceiling."}
  ]
}
