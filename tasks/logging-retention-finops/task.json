{
  "id": "logging-retention-finops",
  "title": "Set investigation-ready retention with a FinOps boundary",
  "level": "practitioner",
  "family": "operate",
  "cloud": "azure",
  "checks": [
    {"check_id":"OBS-001","domain":"operations","points":30,"path":"main.bicep","contains":"retentionInDays\\s*:\\s*(?:[3-8][0-9]|90)","description":"Retain logs for 30–90 days."},
    {"check_id":"OBS-002","domain":"operations","points":20,"path":"main.bicep","contains":"dailyQuotaGb\\s*:\\s*[1-5]","description":"Apply a daily ingestion cap for the synthetic workload."},
    {"check_id":"SEC-001","domain":"security","points":20,"path":"main.bicep","contains":"enableLogAccessUsingOnlyResourcePermissions\\s*:\\s*true","hard_gate":true,"description":"Use resource-context access control."},
    {"check_id":"FIN-001","domain":"finops","points":15,"path":"economics.json","contains":"\"monthly_budget_usd\"\\s*:\\s*(?:[0-9]{1,3}|1000)","description":"Declare a monthly budget no greater than $1,000."},
    {"check_id":"OPS-003","domain":"operations","points":15,"path":"runbook.md","contains":"(?=.*quota)(?=.*alert)(?=.*investigat)","description":"Document quota monitoring, alerting and investigation response."}
  ]
}
